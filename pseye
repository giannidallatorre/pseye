#!/bin/bash
# PS Eye webcam control (wraps vcam.py).
#
#   pseye on         start the webcam (in the background)
#   pseye off        stop the webcam
#   pseye toggle     flip the current state
#   pseye status     show the current state
#   pseye install    auto-start the webcam when the PS Eye is plugged in
#   pseye uninstall  remove the auto-start
#
# Extra arguments after on/toggle are passed to vcam.py, e.g.
#   pseye on --fps 30
set -euo pipefail
# Resolve symlinks so this script also works when linked from ~/.local/bin.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# Python interpreter used for the helper scripts. Override with PSEYE_PYTHON
# if you use a different virtualenv.
PY="${PSEYE_PYTHON:-$DIR/.venv/bin/python}"
LABEL="com.pseye.watch"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$DIR/vcam.log"
PAUSE="$DIR/.paused"
UID_NUM="$(id -u)"

running() { pgrep -f "vcam.py" >/dev/null 2>&1; }
present() { ioreg -w0 -l -r -n "USB Camera-B4.09.24.1" 2>/dev/null | grep -q "IOUSBHostInterface@0"; }
agent_loaded() { launchctl print "gui/$UID_NUM/$LABEL" >/dev/null 2>&1; }

start() {
  rm -f "$PAUSE"
  if running; then echo "PS Eye: already running"; return 0; fi
  if ! present; then echo "PS Eye: not plugged in"; return 1; fi
  nohup "$DIR/vcam.sh" "$@" >"$LOG" 2>&1 &
  sleep 2
  if running; then
    echo "PS Eye: ON  (log: $LOG)"
  else
    echo "PS Eye: failed to start, see $LOG"
    return 1
  fi
}

stop() {
  touch "$PAUSE"
  pkill -f "vcam.py" 2>/dev/null || true
  # vcam.py exits with os._exit(0) and never tells the camera to stop, so the
  # LED would stay on. Turn it off from a separate process, once vcam.py is gone.
  sleep 1
  "$PY" "$DIR/led_off.py" >/dev/null 2>&1 || true
  echo "PS Eye: OFF"
}

case "${1:-status}" in
  on)  shift; start "$@" ;;
  off) stop ;;
  toggle) shift; if running; then stop; else start "$@"; fi ;;
  status)
    if running; then echo "webcam:     ON"; else echo "webcam:     OFF"; fi
    if [[ -f "$PAUSE" ]]; then echo "paused:     yes (manual off)"; else echo "paused:     no"; fi
    if agent_loaded; then echo "auto-start: installed"; else echo "auto-start: not installed"; fi
    ;;
  watch)  # internal: run by launchd every 5s
    if [[ -f "$PAUSE" ]]; then
      if running; then
        pkill -f "vcam.py" 2>/dev/null || true
        sleep 1
        "$PY" "$DIR/led_off.py" >/dev/null 2>&1 || true
      fi
      exit 0
    fi
    if present; then
      if ! running; then nohup "$DIR/vcam.sh" >>"$LOG" 2>&1 & fi
    else
      if running; then pkill -f "vcam.py" 2>/dev/null || true; fi
    fi
    ;;
  install)
    mkdir -p "$(dirname "$PLIST")"
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$DIR/pseye</string>
    <string>watch</string>
  </array>
  <key>StartInterval</key><integer>5</integer>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
EOF
    launchctl bootout "gui/$UID_NUM/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$UID_NUM" "$PLIST"
    echo "auto-start installed: the webcam starts when you plug in the PS Eye."
    ;;
  uninstall)
    launchctl bootout "gui/$UID_NUM/$LABEL" 2>/dev/null || true
    rm -f "$PLIST"
    echo "auto-start removed."
    ;;
  *) echo "usage: pseye {on|off|toggle|status|install|uninstall}"; exit 1 ;;
esac
